  "failures": [
    {
      "stage": "detect",
      "symptom": "无口令时无法确定 main_key，文件名混淆解不开。",
      "root_cause": "文件名 = MT(main_key+i) 的 52 字母表轮换，main_key 原取自 exe 的 V_CODE2 资源，而本作没有。",
      "fix": "先逐条目穷举 k0（只有 256 种）反推，再用 entry_i 的 k0 做约束 C# 并行爆破 main_key（本作 0x212C5F31），伪命中用 pcm 包 .ogg 率甄别。",
      "ref": "verified-findings §16.2"
    },
    {
      "stage": "postprocess",
      "symptom": "107 个 24bpp HG-3 变体解码时 Array.Copy 越界崩溃。",
      "root_cause": "_hg3_tool.cs 的 DecodeFile flip 阶段硬编码 row=w*4，24bpp 时 px 只有 w*h*3 字节。",
      "fix": "row = w*(bpp/8) + 按 bpp 选 Format24bppRgb；移植前先拉原版源码对拍语义，ApplyDelta 的 4 等分位转置对 24bpp 无需改。",
      "ref": "verified-findings §16.5"
    },
    {
      "stage": "reconcile",
      "symptom": "一次完全正确的解包被自己的护栏判成「产物不足」，整条链 rc=1。",
      "root_cause": "期望张数按大小写敏感去重算 4501，而 NTFS 上 X.png 与 x.png 是同一文件、实际 4499。",
      "fix": "去重键按平台语义（Windows 不区分大小写）；产物判定看 png/ 目录总量 == 期望，不看本轮增量。",
      "ref": "verified-findings §16.6"
    },
    {
      "stage": "postprocess",
      "symptom": "提取后 .ogg 只有 417 个，其余媒体散落在几十个随机扩展名上。",
      "root_cause": "引擎对扩展名做二次混淆（OggS 共 10915 个，按文件轮换、转到 0 才露真名）。",
      "fix": "按魔数统一归一扩展名后再验收；不归一则乱扩展名的媒体会落进 verify 的 nonmedia 被静默放过。",
      "ref": "verified-findings §16.6"
    },
    {
      "stage": "verify",
      "symptom": "尾部 fsize % 8 字节看起来像漏解的密文。",
      "root_cause": "打包器只加密整 8 字节块，落盘尾部零头本来就是明文。",
      "fix": "只解整块（fsize//8*8）+ 尾部原样照抄是正确实现；用最后一个 Ogg 页 CRC 判明（23259 个全过，87.6% 大小非 8 倍数）。",
      "ref": "verified-findings §16.6"
    }
  ],
